X= v (:, 1:end-1);
Xprime= v (:, 2:end);
[U,S,V]= svd(X,'econ');

% Calculate the error between the original and reduced data

info= niftiinfo("sub-01_task-amb_acq-2depimb4_run-02_SCSTBL_3DMCTS_bvbabel_undist_fix_THPGLMF3c_sess-03_BBR_bvbabel.nii")
v=niftiread(info);

[U,Sigma,V] = svd(X,'econ');

% select optimal number of of modes to keep
beta = size(Sigma,2)/size(Sigma,1);
threshold = optimal_SVHT_coef(beta,Sigma);
r = sum(diag(Sigma) >= threshold);

%we are keeping only the r most important directions
% the highest singular values
Ur = U(:,1:r);  
Sigmar = Sigma(1:r,1:r);
Vr = V(:,1:r);

Atilde = Ur'*Xprime*Vr/Sigmar;
[W,Lambda] = eig(Atilde);

% real part of DMD modes
Phi = real(Xprime*(Vr/Sigmar)*W);

Phi = reshape(Phi,[78,96,78,r]);

% Keep only 9 modes just for visualization

%Phi = Phi(:,:,:,1:9);

